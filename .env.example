# Possible options are prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=
# Set to true to disable periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active. Accepts true/1 or false/0.
OPENEMR__NO_BACKGROUND_TASKS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_TEXTRACT_UPLOAD_BUCKET=
AWS_MEDICAL_DOCUMENT_GUARD_ENABLED=true
AWS_COMPREHEND_MEDICAL_MIN_ENTITIES=2
AWS_COMPREHEND_MEDICAL_MIN_SCORE=0.70
AI_COPILOT_DOCUMENT_INGESTION_ENABLED=true
AI_COPILOT_RAG_ENABLED=true
AI_COPILOT_GUIDELINE_RAG_ENABLED=true
AI_COPILOT_HYBRID_RAG_ENABLED=true
AI_COPILOT_EMBEDDINGS_ENABLED=true
AI_COPILOT_EMBEDDINGS_MODEL=text-embedding-3-small
AI_COPILOT_VECTOR_STORE=local
AI_COPILOT_TOP_K_SPARSE=8
AI_COPILOT_TOP_K_DENSE=8
AI_COPILOT_SPARSE_WEIGHT=0.45
AI_COPILOT_DENSE_WEIGHT=0.55
AI_COPILOT_MAX_HYBRID_CANDIDATES=20
AI_COPILOT_RERANK_PROVIDER=cohere
AI_COPILOT_RERANK_MODEL=rerank-v3.5
AI_COPILOT_TOP_K_RERANKED=5
AI_COPILOT_LANGGRAPH_ENABLED=false
COHERE_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openemr-ai-copilot
