{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openemr-ai-copilot/lab_pdf.schema.json",
  "title": "LabPdfExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "patient_id",
    "source_document_id",
    "extraction_status",
    "confidence",
    "extracted_at",
    "labs",
    "missing_or_ambiguous_data",
    "source_citations",
    "safety_warnings",
    "review_status"
  ],
  "properties": {
    "document_type": {
      "const": "lab_pdf"
    },
    "patient_id": {
      "type": "string",
      "minLength": 1
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "extraction_status": {
      "type": "string",
      "enum": ["ok", "review_required", "failed"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "labs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/labItem"
      }
    },
    "missing_or_ambiguous_data": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/reviewIssue"
          }
        ]
      }
    },
    "source_citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceCitation"
      }
    },
    "safety_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_status": {
      "const": "pending_clinician_review"
    }
  },
  "$defs": {
    "reviewIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "issue",
        "suggested_review_action"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "suggested_review_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_id",
        "quote_or_value",
        "confidence"
      ],
      "properties": {
        "source_document_id": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": ["integer", "null"]
        },
        "page_or_section": {
          "type": "string"
        },
        "quote_or_value": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "anyOf": [
        {
          "required": ["page_number"]
        },
        {
          "required": ["page_or_section"]
        }
      ]
    },
    "labItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_name",
        "value",
        "unit",
        "reference_range",
        "collection_date",
        "abnormal_flag",
        "source_citation",
        "review_status"
      ],
      "properties": {
        "test_name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "number"
            }
          ]
        },
        "unit": {
          "type": "string"
        },
        "reference_range": {
          "type": "string"
        },
        "collection_date": {
          "type": "string"
        },
        "abnormal_flag": {
          "type": "string",
          "enum": ["normal", "high", "low", "critical", "abnormal", "unknown"]
        },
        "source_citation": {
          "$ref": "#/$defs/sourceCitation"
        },
        "resulted_date": {
          "type": "string"
        },
        "loinc_code": {
          "type": "string"
        },
        "proposed_fhir_resource_type": {
          "type": "string",
          "enum": ["Observation", "DiagnosticReport", "Specimen", "ServiceRequest"]
        },
        "review_status": {
          "const": "pending_clinician_review"
        },
        "source_document_id": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": ["integer", "null"]
        },
        "source_quote_or_value": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
