{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openemr-ai-copilot/intake_form.schema.json",
  "title": "IntakeFormExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "patient_id",
    "source_document_id",
    "extraction_status",
    "confidence",
    "extracted_at",
    "demographics",
    "chief_concern",
    "current_medications",
    "allergies",
    "family_history",
    "missing_or_ambiguous_data",
    "source_citations",
    "safety_warnings",
    "review_status"
  ],
  "properties": {
    "document_type": {
      "const": "intake_form"
    },
    "patient_id": {
      "type": "string",
      "minLength": 1
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "extraction_status": {
      "type": "string",
      "enum": ["ok", "review_required", "failed"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "demographics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_name",
        "last_name",
        "date_of_birth",
        "phone",
        "email",
        "address",
        "emergency_contact"
      ],
      "properties": {
        "first_name": {
          "$ref": "#/$defs/fieldValue"
        },
        "last_name": {
          "$ref": "#/$defs/fieldValue"
        },
        "date_of_birth": {
          "$ref": "#/$defs/fieldValue"
        },
        "phone": {
          "$ref": "#/$defs/fieldValue"
        },
        "email": {
          "$ref": "#/$defs/fieldValue"
        },
        "address": {
          "$ref": "#/$defs/fieldValue"
        },
        "emergency_contact": {
          "$ref": "#/$defs/fieldValue"
        }
      }
    },
    "chief_concern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source_citation",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "source_citation": {
          "$ref": "#/$defs/sourceCitation"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "current_medications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/medicationItem"
      }
    },
    "allergies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allergyItem"
      }
    },
    "family_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/familyHistoryItem"
      }
    },
    "missing_or_ambiguous_data": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/reviewIssue"
          }
        ]
      }
    },
    "source_citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceCitation"
      }
    },
    "safety_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_status": {
      "const": "pending_clinician_review"
    }
  },
  "$defs": {
    "reviewIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "issue",
        "suggested_review_action"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "suggested_review_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_id",
        "quote_or_value",
        "confidence"
      ],
      "properties": {
        "source_document_id": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": ["integer", "null"]
        },
        "page_or_section": {
          "type": "string"
        },
        "quote_or_value": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "anyOf": [
        {
          "required": ["page_number"]
        },
        {
          "required": ["page_or_section"]
        }
      ]
    },
    "fieldValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source_citation",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "source_citation": {
          "$ref": "#/$defs/sourceCitation"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "medicationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medication_name",
        "dose",
        "frequency",
        "source_citation",
        "confidence",
        "review_status"
      ],
      "properties": {
        "medication_name": {
          "type": "string",
          "minLength": 1
        },
        "dose": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "source_citation": {
          "$ref": "#/$defs/sourceCitation"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": {
          "const": "pending_clinician_review"
        }
      }
    },
    "allergyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allergen",
        "reaction",
        "severity",
        "source_citation",
        "confidence",
        "review_status"
      ],
      "properties": {
        "allergen": {
          "type": "string",
          "minLength": 1
        },
        "reaction": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "source_citation": {
          "$ref": "#/$defs/sourceCitation"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": {
          "const": "pending_clinician_review"
        }
      }
    },
    "familyHistoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "condition",
        "source_citation",
        "confidence",
        "review_status"
      ],
      "properties": {
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "age_of_onset": {
          "type": "string"
        },
        "source_citation": {
          "$ref": "#/$defs/sourceCitation"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": {
          "const": "pending_clinician_review"
        }
      }
    }
  }
}
